.env
.env.local

# AI assistant instructions
CLAUDE.md

.venv/

# MCP registration. The "command" is an absolute path to a machine-specific
# interpreter, so a committed copy breaks every other machine. Copy
# .mcp.json.example instead.
.mcp.json
