    {"op": "block", "pos": [6, 3, 0], "block": "glass_pane"},
    {"op": "block", "pos": [2, 3, 6], "block": "glass_pane"},
    {"op": "block", "pos": [6, 3, 6], "block": "glass_pane"},
    {"op": "block", "pos": [0, 3, 3], "block": "glass_pane"},
    {"op": "block", "pos": [8, 3, 3], "block": "glass_pane"},

    {"op": "cuboid", "start": [9, 1, 3], "end": [9, 11, 3], "block": "cobblestone"},

    {"op": "block", "pos": [3, 4, -1], "block": "chain"},
