    {"op": "cuboid", "start": [8, 1, 0], "end": [8, 4, 0], "block": "stripped_oak_log[axis=y]"},
    {"op": "cuboid", "start": [0, 1, 6], "end": [0, 4, 6], "block": "stripped_oak_log[axis=y]"},
    {"op": "cuboid", "start": [8, 1, 6], "end": [8, 4, 6], "block": "stripped_oak_log[axis=y]"},

    {"op": "cuboid", "start": [-1, 5, -1], "end": [9, 5, 7], "block": "dark_oak_planks"},
    {"op": "cuboid", "start": [0, 6, 0], "end": [8, 6, 6], "block": "dark_oak_planks"},
    {"op": "cuboid", "start": [1, 7, 1], "end": [7, 7, 5], "block": "dark_oak_planks"},
    {"op": "cuboid", "start": [2, 8, 2], "end": [6, 8, 4], "block": "dark_oak_planks"},
    {"op": "cuboid", "start": [3, 9, 3], "end": [5, 9, 3], "block": "dark_oak_planks"},

    {"op": "cuboid", "start": [4, 1, 0], "end": [4, 3, 0], "block": "air"},
